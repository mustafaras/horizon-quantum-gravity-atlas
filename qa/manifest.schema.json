{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mustafaras/horizon-quantum-gravity-atlas/qa/manifest.schema.json",
  "title": "HORIZON capture manifest",
  "description": "Machine-readable contract for every committed screenshot: which app state, which viewport, which readiness conditions, and which scientific status the image carries.",
  "type": "object",
  "required": ["schema", "version", "app", "defaults", "captures"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "horizon-qga-capture-manifest/v1" },
    "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "app": {
      "type": "object",
      "required": ["entry", "basePath"],
      "additionalProperties": false,
      "properties": {
        "entry": { "type": "string" },
        "basePath": { "type": "string" },
        "stateKeys": {
          "type": "object",
          "description": "Canonical URL parameter names mirrored from js/state.jsx QGA_STATE_KEYS; the verifier cross-checks capture URLs against this table.",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "defaults": {
      "type": "object",
      "required": ["viewport", "motion", "pathway", "seed", "readiness"],
      "additionalProperties": false,
      "properties": {
        "viewport": { "$ref": "#/$defs/viewport" },
        "motion": { "enum": ["reduced", "balanced", "cinematic"] },
        "pathway": { "enum": ["beginner", "student", "advanced"] },
        "seed": { "type": "integer" },
        "timeoutMs": { "type": "integer", "minimum": 1000 },
        "readiness": {
          "type": "array",
          "items": { "$ref": "#/$defs/readiness" },
          "minItems": 1
        }
      }
    },
    "captures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capture" }
    }
  },
  "$defs": {
    "viewport": {
      "type": "object",
      "required": ["width", "height", "deviceScaleFactor"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 280 },
        "height": { "type": "integer", "minimum": 400 },
        "deviceScaleFactor": { "type": "number", "minimum": 1, "maximum": 3 },
        "label": { "type": "string" }
      }
    },
    "readiness": {
      "description": "Measurable ready conditions. Fixed-duration sleeps are forbidden; every wait must terminate on an observable predicate.",
      "oneOf": [
        { "const": "fonts", "description": "document.fonts.ready resolves" },
        { "const": "network-idle", "description": "no in-flight requests for 500 ms" },
        { "const": "view-mounted", "description": "the view root selector is attached and non-empty" },
        { "const": "canvas-nonblank", "description": "at least one canvas has non-uniform pixels" },
        { "const": "animation-settled", "description": "rAF cadence observed; capture waits for a quiet frame window" },
        {
          "type": "object",
          "required": ["selector"],
          "additionalProperties": false,
          "properties": {
            "selector": { "type": "string", "minLength": 1 },
            "state": { "enum": ["attached", "visible"], "default": "visible" },
            "text": { "type": "string", "description": "optional text the selector must contain" }
          }
        }
      ]
    },
    "capture": {
      "type": "object",
      "required": ["id", "file", "description", "view", "url", "viewport", "scientificStatus", "scope"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Stable kebab-case identifier; renaming an id is a breaking change for baselines."
        },
        "file": {
          "type": "string",
          "pattern": "^docs/screenshots/.+\\.png$",
          "description": "Committed PNG this capture produces."
        },
        "description": { "type": "string", "minLength": 10 },
        "view": {
          "enum": ["overview", "sm", "qft", "rg", "gr", "planck", "approaches", "bh", "exp", "glossary", "refs", "open"]
        },
        "url": {
          "type": "string",
          "description": "Canonical query string (may be empty for defaults). Every parameter must be a known state key.",
          "pattern": "^(\\?.*)?$"
        },
        "pathway": { "enum": ["beginner", "student", "advanced"] },
        "seed": { "type": "integer" },
        "viewport": { "$ref": "#/$defs/viewport" },
        "motion": { "enum": ["reduced", "balanced", "cinematic"] },
        "colorScheme": { "enum": ["dark", "light"], "default": "dark" },
        "scope": {
          "description": "page = full scrollable document; viewport = above the fold; element = the target selector's box.",
          "enum": ["page", "viewport", "element"]
        },
        "target": {
          "type": "string",
          "description": "CSS selector for element-scope captures and for scroll-into-view before page captures."
        },
        "readiness": {
          "type": "array",
          "items": { "$ref": "#/$defs/readiness" },
          "description": "Overrides or extends the default readiness list for this capture."
        },
        "settleMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000,
          "description": "Upper bound for the animation-settled probe, not a fixed sleep."
        },
        "scientificStatus": {
          "description": "Epistemic status the image carries, mirroring the app's status taxonomy.",
          "enum": ["established", "effective-model", "approximation", "generated", "observation", "conjectural", "documentation"]
        },
        "statusNote": { "type": "string", "description": "Why this status; surfaced in reports." },
        "fixture": {
          "type": "string",
          "description": "Network fixture id required before capture (e.g. a GWOSC stub).",
          "enum": ["gwosc-gw150914"]
        },
        "readme": {
          "type": "boolean",
          "description": "True when README.md references this file; the verifier cross-checks both directions."
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxDiffPixelRatio": { "type": "number", "minimum": 0, "maximum": 1 },
            "note": { "type": "string", "description": "Justification for the tolerance (text, geometry, animation, WebGL)." }
          },
          "required": ["maxDiffPixelRatio", "note"]
        }
      }
    }
  }
}
